{
  "version": "<N>",
  "reference_design": "design/<approved_mockup_or_screenshot>.png",
  "design_anchors": "design/design_anchors.json",
  "runtime_evidence": "evidence/ui_frames.json",

  "evidence_contract": {
    "rule": "The validator calculates all design-anchor deltas from runtime_evidence; do not record expected, actual, or pass/fail values in structural_verification.checks.",
    "frame_capture": "Produced by an XCUITest that reads named accessibilityIdentifier visual bounds in pt."
  },

  "build_and_static_checks": {
    "xcodebuild build": "PASS / FAIL",
    "lintDebug": "PASS / FAIL",
    "swiftlintCheck": "PASS / FAIL"
  },

  "instrumented_tests": {
    "passed": "<N>",
    "total": "<N>"
  },

  "normalization": {
    "reference_resolution": "<e.g. 390×844>",
    "reference_density": "<e.g. 2x>",
    "runtime_resolution": "<e.g. 1080×2400>",
    "runtime_density": "<e.g. 2.75x>",
    "logical_space": "<e.g. 390×844 dp>",
    "theme": { "reference": "light / dark", "runtime": "light / dark", "match": true },
    "font_scale": { "reference": 1.0, "runtime": 1.0, "match": true },
    "locale": { "reference": "en-US", "runtime": "en-US", "match": true }
  },

  "scope": {
    "type": "partial / full-screen",
    "area_of_interest": "<description, e.g. bottom toolbar and emoji picker panel>",
    "rationale": "<which spec/plan section drives this scope>",
    "in_scope_regions": [
      "<region_name>"
    ],
    "out_of_scope_regions": [
      "<region_name>"
    ]
  },

  "regression_checks": [
    {
      "region": "<out-of-scope region>",
      "exists": true,
      "not_clipped": true,
      "no_layout_shift": true,
      "result": "PASS / FAIL"
    }
  ],

  "region_decomposition": [
    {
      "region": "<region_name>",
      "bounds_dp": { "x_start": 0, "x_end": 390, "y_start": 0, "y_end": 56 }
    }
  ],

  "structural_verification": {
    "checks": [
      {
        "region": "<region>",
        "screen": "<screen_name_in_runtime_evidence>",
        "element_id": "<visual_bounds_accessibilityIdentifier>",
        "metric": "<x / y / width / height>",
        "note": "<what this anchor proves; numeric expected/tolerance live only in design/design_anchors.json>"
      }
    ]
  },

  "design_anchors_schema": {
    "coordinate_space": { "unit": "pt", "reference_resolution": { "width": 390, "height": 844 } },
    "anchors": [
      {
        "screen": "<screen_name>",
        "element_id": "<visual_bounds_accessibilityIdentifier>",
        "metric": "<x / y / width / height>",
        "expected": "<number measured from approved design>",
        "tolerance_pt": "<non-negative number>"
      }
    ]
  },

  "runtime_evidence_schema": {
    "producer": { "kind": "XCUITest", "test_name": "<test class/method>" },
    "coordinate_space": { "unit": "pt" },
    "normalization": { "theme": "light", "font_scale": 1.0, "locale": "en-US" },
    "screens": [
      {
        "name": "<screen_name>",
        "screenshot": "evidence/<screen>.png",
        "elements": {
          "<accessibilityIdentifier>": { "x": 0, "y": 0, "width": 0, "height": 0 }
        }
      }
    ]
  },

  "dynamic_content_masking": [
    {
      "region": "<region>",
      "rationale": "<why masked — e.g. runtime-variable balance>"
    }
  ],

  "perceptual_comparison": [
    {
      "region": "<region>",
      "confidence": "high / medium / low",
      "notes": "<observations>"
    }
  ],

  "defect_classification": [
    {
      "id": 1,
      "region": "<region>",
      "severity": "critical / major / minor",
      "description": "<description>",
      "suggested_fix": "<suggestion>",
      "status": "open / fixed"
    }
  ],

  "ai_visual_evaluation": {
    "status": "PASS / FAIL",
    "area_of_interest": "<description>",
    "issues": [
      {
        "region": "<region>",
        "severity": "critical / major / minor",
        "issue": "<description>",
        "suggestion": "<fix>"
      }
    ],
    "regression_summary": {
      "<out-of-scope region>": "PASS — exists, visible, no layout shift"
    }
  },

  "design_deviations": [
    "<none / list each visual deviation from the original design screenshot>"
  ],

  "verdict": {
    "result": "PASS / FAIL",
    "reason": "<reason if fail>",
    "critical_findings": 0,
    "major_findings_unresolved": 0,
    "minor_findings_warnings": 0
  }
}
