<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.android.__PROJECT_SLUG__.harness-generator</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__PROJECT_ROOT__/harness/scripts/auto-harness-generator.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- Run every 1800 seconds = 30 minutes -->
    <key>StartInterval</key>
    <integer>1800</integer>

    <!-- Do not fire on load; wait for the next interval tick. -->
    <key>RunAtLoad</key>
    <false/>

    <!-- Persist output for debugging in user's Library/Logs directory. -->
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/com.android.__PROJECT_SLUG__.harness-generator.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/com.android.__PROJECT_SLUG__.harness-generator.log</string>

    <!-- Run only while the user is logged in at the GUI session. -->
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>

    <key>AbandonProcessGroup</key>
    <true/>
</dict>
</plist>
